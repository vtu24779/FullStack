/* ── Home Page ────────────────────────────── */
.cp-home { padding-top: 68px; }

/* Hero */
.cp-hero {
  padding: 80px 0 64px;
  background: var(--surface);
  position: relative;
  overflow: hidden;
}
.cp-hero::before {
  content: '';
  position: absolute;
  top: -120px;
  right: -120px;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(152,89,51,0.08) 0%, transparent 70%);
  pointer-events: none;
}

.cp-hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}

.cp-hero-content { display: flex; flex-direction: column; gap: 24px; }

.cp-hero-title   { color: var(--primary); margin-top: 12px; }
.cp-hero-accent  { color: var(--secondary); }
.cp-hero-desc    { color: var(--on-surface-var); max-width: 440px; }

.cp-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

.cp-hero-stats {
  display: flex;
  align-items: center;
  gap: 20px;
  padding-top: 8px;
}
.cp-stat { display: flex; flex-direction: column; gap: 2px; }
.cp-stat-num {
  font-family: var(--font-headline);
  font-size: 22px;
  font-weight: 700;
  color: var(--primary);
}
.cp-stat-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--on-surface-var);
}
.cp-stat-divider {
  width: 1px;
  height: 32px;
  background: var(--outline-var);
}

/* Hero Cards */
.cp-hero-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 16px;
  position: relative;
}

.cp-hero-card {
  background: var(--surface-container);
  border: 1px solid var(--outline-var);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.22s, transform 0.22s;
}
.cp-hero-card:hover {
  box-shadow: var(--shadow-hover);
  transform: translateY(-4px);
}
.cp-hero-card-0 { grid-column: 1 / -1; }

.cp-hero-card-img-placeholder {
  width: 100%;
  height: 160px;
  background: linear-gradient(135deg, var(--tertiary-container), var(--secondary-container));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3.5rem;
}
.cp-hero-card-0 .cp-hero-card-img-placeholder { height: 200px; }

.cp-hero-card-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.cp-hero-card-cat {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--secondary);
}
.cp-hero-card-title {
  font-family: var(--font-headline);
  font-size: 15px;
  font-weight: 600;
  color: var(--on-surface);
  line-height: 1.25;
}
.cp-hero-card-date {
  font-size: 12px;
  color: var(--on-surface-var);
}
.cp-hero-empty {
  grid-column: 1 / -1;
  padding: 60px;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--on-surface-var);
}

/* Sections */
.cp-section        { padding: 72px 0; }
.cp-section-alt    { background: var(--surface-low); }

.cp-section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 36px;
  gap: 16px;
}
.cp-section-header .headline-lg { margin-top: 8px; }

/* Category Grid */
.cp-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.cp-cat-card {
  background: var(--surface-container);
  border: 1px solid var(--outline-var);
  border-radius: var(--radius-xl);
  padding: 28px 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  text-decoration: none;
  color: inherit;
  transition: all 0.22s ease;
}
.cp-cat-card:hover {
  background: var(--primary);
  border-color: var(--primary);
  transform: translateY(-3px);
  box-shadow: var(--shadow-hover);
}
.cp-cat-card:hover .cp-cat-name  { color: var(--on-primary); }
.cp-cat-card:hover .cp-cat-count { color: rgba(255,255,255,0.65); }
.cp-cat-icon  { font-size: 2rem; }
.cp-cat-name  {
  font-family: var(--font-headline);
  font-size: 16px;
  font-weight: 600;
  color: var(--on-surface);
}
.cp-cat-count {
  font-size: 13px;
  color: var(--on-surface-var);
}

/* Events Grid */
.cp-events-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

/* Empty */
.cp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 80px 0;
  text-align: center;
}

/* CTA Banner */
.cp-cta-banner {
  background: var(--primary);
  border-radius: var(--radius-2xl);
  padding: 56px 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48px;
  overflow: hidden;
  position: relative;
}
.cp-cta-banner::before {
  content: '';
  position: absolute;
  bottom: -60px;
  left: -60px;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  pointer-events: none;
}
.cp-cta-content {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.cp-cta-content .section-label { color: var(--secondary-container); }
.cp-cta-content .section-label::after { background: rgba(247,241,220,0.2); }
.cp-cta-decoration {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12px;
  flex-shrink: 0;
}
.cp-cta-emoji {
  width: 72px;
  height: 72px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.2rem;
}
.cp-cta-emoji.sm {
  width: 52px;
  height: 52px;
  font-size: 1.6rem;
}

/* Footer */
.cp-footer {
  border-top: 1px solid var(--outline-var);
  padding: 32px 0;
}
.cp-footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.cp-footer-links {
  display: flex;
  gap: 24px;
}
.cp-footer-links a {
  font-size: 14px;
  font-weight: 500;
  color: var(--on-surface-var);
  transition: color 0.18s;
}
.cp-footer-links a:hover { color: var(--primary); }

/* Responsive */
@media (max-width: 1024px) {
  .cp-cat-grid     { grid-template-columns: repeat(2, 1fr); }
  .cp-events-grid  { grid-template-columns: repeat(2, 1fr); }
  .cp-hero-inner   { grid-template-columns: 1fr; }
  .cp-hero-cards   { grid-template-columns: repeat(3, 1fr); }
  .cp-hero-card-0  { grid-column: auto; }
  .cp-hero-card-0 .cp-hero-card-img-placeholder { height: 160px; }
}

@media (max-width: 768px) {
  .cp-hero           { padding: 48px 0 40px; }
  .cp-section        { padding: 48px 0; }
  .cp-cat-grid       { grid-template-columns: repeat(2, 1fr); }
  .cp-events-grid    { grid-template-columns: 1fr; }
  .cp-cta-banner     { padding: 36px 28px; flex-direction: column; }
  .cp-cta-decoration { flex-direction: row; }
  .cp-hero-cards     { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 480px) {
  .cp-cat-grid  { grid-template-columns: 1fr 1fr; }
  .cp-hero-stats { gap: 12px; }
  .cp-cta-banner { padding: 28px 20px; }
}
